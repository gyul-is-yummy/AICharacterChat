<Window x:Class="AICharacterChat.SummaryPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="요약 미리보기" Height="760" Width="620"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        MinHeight="620" MinWidth="520"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SummaryTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5f6fa0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="요약 미리보기"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#e0aaff"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="요약 생성 중..."
                       Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="#d8e6ff"
                       FontSize="13"
                       Margin="0,0,0,6"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="#ff9999"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="제목"
                               Foreground="#aaaacc"
                               FontSize="13"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleLengthText}"
                               Foreground="#aaaacc"
                               FontSize="12"/>
                </Grid>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Background="#16213e"
                         Foreground="White"
                         BorderBrush="#e0aaff"
                         BorderThickness="1"
                         Padding="8"
                         FontSize="14"
                         Margin="0,0,0,14"/>

                <TextBlock Text="현재 상황" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CurrentSituation, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="86"
                         Margin="0,0,0,14"/>

                <TextBlock Text="주요 사건" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding KeyEvents, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="100"
                         Margin="0,0,0,14"/>

                <TextBlock Text="관계 변화" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding RelationshipChanges, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="86"
                         Margin="0,0,0,14"/>

                <TextBlock Text="약속 / 중요한 발언" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PromisesAndImportantStatements, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="86"
                         Margin="0,0,0,14"/>

                <TextBlock Text="미해결 사항" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding UnresolvedMatters, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="86"
                         Margin="0,0,0,14"/>

                <TextBlock Text="지속 상태" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PersistentState, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SummaryTextBoxStyle}"
                         Height="86"
                         Margin="0,0,0,10"/>

                <TextBlock Text="다시 생성하면 현재 편집 내용이 새 결과로 대체됩니다."
                           Foreground="#8f9fca"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="{Binding RegenerateButtonText}"
                    Width="92"
                    Height="34"
                    Margin="0,0,8,0"
                    Background="#24345f"
                    Foreground="#e8ddff"
                    BorderBrush="#5f6fa0"
                    BorderThickness="1"
                    Cursor="Hand"
                    Command="{Binding RegenerateCommand}"/>
            <Button Content="취소"
                    Width="82"
                    Height="34"
                    Margin="0,0,8,0"
                    Background="#2a2a4a"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}"/>
            <Button Content="저장"
                    Width="82"
                    Height="34"
                    Background="#e0aaff"
                    Foreground="#1a1a2e"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
