<Window x:Class="AICharacterChat.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API 설정" Height="300" Width="430"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Anthropic API Key"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#e0aaff"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="새 키를 입력하면 저장된 키를 교체합니다."
                       Foreground="#aaaacc"
                       FontSize="12"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="ApiKeyPasswordBox"
                         Background="#16213e"
                         Foreground="White"
                         BorderBrush="#e0aaff"
                         BorderThickness="1"
                         Padding="8"
                         FontSize="13"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#101832"
                BorderBrush="#38466f"
                BorderThickness="1"
                CornerRadius="6"
                Padding="9,7"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#d8e6ff"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                   Foreground="#ff9999"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="저장 / 교체"
                    Width="96"
                    Height="32"
                    Margin="0,0,8,0"
                    Background="#e0aaff"
                    Foreground="#1a1a2e"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>
            <Button Content="저장된 키 삭제"
                    Width="110"
                    Height="32"
                    Margin="0,0,8,0"
                    Background="#2a213d"
                    Foreground="#ffdddd"
                    BorderBrush="#6f4b6f"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="DeleteButton_Click"/>
            <Button Content="닫기"
                    Width="72"
                    Height="32"
                    Background="#2a2a4a"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
