<Window x:Class="AICharacterChat.CharacterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 설정" Height="820" Width="450"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <TextBlock Grid.Row="0" Text="캐릭터 설정"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#e0aaff"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- 이름 -->
            <TextBlock Grid.Row="1" Text="이름"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Grid.Row="2"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="14" Margin="0,0,0,14"/>

            <!-- 나이 / 성별 / 직업 -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="나이"
                               Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="AgeBox"
                             Background="#16213e" Foreground="White"
                             BorderBrush="#e0aaff" BorderThickness="1"
                             Padding="8" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="성별"
                               Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GenderBox"
                              Background="#16213e" Foreground="White"
                              BorderBrush="#e0aaff" BorderThickness="1"
                              FontSize="13" Height="36" Padding="6,0">
                        <ComboBoxItem Content="남"/>
                        <ComboBoxItem Content="여"/>
                        <ComboBoxItem Content="기타"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="직업"
                               Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="JobBox"
                             Background="#16213e" Foreground="White"
                             BorderBrush="#e0aaff" BorderThickness="1"
                             Padding="8" FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- 외형 -->
            <TextBlock Grid.Row="4" Text="외형"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="AppearanceBox" Grid.Row="5"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- 성격 -->
            <TextBlock Grid.Row="6" Text="성격"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="PersonalityBox" Grid.Row="7"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- 관계 -->
            <TextBlock Grid.Row="8" Text="다른 캐릭터와의 관계"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <Border Grid.Row="9"
                    BorderBrush="#3a3a6a" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,14" Padding="8">
                <StackPanel x:Name="RelationshipsPanel"/>
            </Border>

            <!-- 기타 -->
            <TextBlock Grid.Row="10" Text="기타"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="EtcBox" Grid.Row="11"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- 비밀 -->
            <TextBlock Grid.Row="12"
                       Text="🔒 비밀 (행동으로만 암시, 직접 발설 안 함)"
                       Foreground="#ff9999" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="SecretBox" Grid.Row="13"
                     Background="#1e1020" Foreground="White"
                     BorderBrush="#ff9999" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- 말투 -->
            <TextBlock Grid.Row="14" Text="말투 규칙"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="SpeechStyleBox" Grid.Row="15"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- 상황 -->
            <TextBlock Grid.Row="16" Text="상황 설정"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="SituationBox" Grid.Row="17"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#e0aaff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="70"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <!-- ★ 추가 항목 섹션 -->
            <Grid Grid.Row="18" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="추가 항목"
                           Foreground="#aaaacc" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="AddFieldButton"
                        Content="＋ 항목 추가"
                        Height="28" Padding="10,0"
                        Background="#2a2a5a" Foreground="#aaaaff"
                        BorderBrush="#5555aa" BorderThickness="1"
                        FontSize="12" Cursor="Hand"
                        Click="AddFieldButton_Click"/>
            </Grid>

            <!-- 추가 항목 목록 (동적 생성) -->
            <StackPanel x:Name="CustomFieldsPanel"
                        Grid.Row="19"
                        Margin="0,0,0,20"/>

            <!-- 구분선 -->
            <Separator Grid.Row="20" Background="#3a3a5a" Margin="0,0,0,16"/>

            <!-- 유저 프로필 선택 -->
            <TextBlock Grid.Row="21"
                       Text="대화 상대 (유저) 프로필"
                       FontSize="15" FontWeight="Bold"
                       Foreground="#ffccaa" Margin="0,0,0,10"/>

            <Grid Grid.Row="22" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="UserProfileComboBox"
                          Grid.Column="0"
                          Background="#16213e" Foreground="White"
                          BorderBrush="#ffccaa" BorderThickness="1"
                          FontSize="13" Height="34" Padding="8,0"/>
                <Button Grid.Column="2"
                        x:Name="ManageUserProfilesButton"
                        Content="유저 관리"
                        Height="34" Padding="12,0"
                        Background="#cc7733" Foreground="White"
                        BorderThickness="0" FontSize="12" Cursor="Hand"
                        Click="ManageUserProfiles_Click"/>
            </Grid>

            <!-- 버튼 -->
            <StackPanel Grid.Row="23" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="취소"
                        Width="90" Height="36" Margin="0,0,10,0"
                        Background="#2a2a4a" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="저장"
                        Width="90" Height="36"
                        Background="#7b2ff7" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>