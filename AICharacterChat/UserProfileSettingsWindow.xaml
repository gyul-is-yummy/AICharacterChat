<Window x:Class="AICharacterChat.UserProfileSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="유저 프로필 설정" Height="520" Width="400"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="유저 프로필 설정"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#ffccaa"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Text="이름 (캐릭터가 부르는 이름)"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Grid.Row="2"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#ffccaa" BorderThickness="1"
                     Padding="8" FontSize="14" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="3" Text="외형"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="AppearanceBox" Grid.Row="4"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#ffccaa" BorderThickness="1"
                     Padding="8" FontSize="13" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <TextBlock Grid.Row="5" Text="성격"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="PersonalityBox" Grid.Row="6"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#ffccaa" BorderThickness="1"
                     Padding="8" FontSize="13" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <TextBlock Grid.Row="7" Text="추가 설정 (관계, 배경 등)"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="AdditionalInfoBox" Grid.Row="8"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#ffccaa" BorderThickness="1"
                     Padding="8" FontSize="13" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,24"/>

            <StackPanel Grid.Row="10" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                <Button x:Name="CancelButton" Content="취소"
                        Width="90" Height="36" Margin="0,0,10,0"
                        Background="#2a2a4a" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="저장"
                        Width="90" Height="36"
                        Background="#cc7733" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>