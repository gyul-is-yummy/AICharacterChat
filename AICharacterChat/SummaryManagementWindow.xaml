<Window x:Class="AICharacterChat.SummaryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="요약 관리" Height="760" Width="860"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        MinHeight="620" MinWidth="760"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SummaryTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5f6fa0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="저장된 대화 요약"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#e0aaff"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#101832"
                    BorderBrush="#38466f"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="요약 목록"
                               Foreground="#aaaacc"
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Summaries}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             IsEnabled="{Binding IsListInteractionEnabled}"
                             Background="#16213e"
                             BorderBrush="#38466f"
                             Foreground="White"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,4">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#f0dcff"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding UpdatedAtText}"
                                               Foreground="#8f9fca"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#101832"
                    BorderBrush="#38466f"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <TextBlock Text="저장된 요약이 없습니다.&#x0a;&#x0a;대화에서 '요약 만들기'를 사용해&#x0a;요약을 추가할 수 있습니다."
                               Visibility="{Binding HasNoSummaries, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="#8f9fca"
                               FontSize="14"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                    <Grid Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="#ff9999"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="요약을 저장하는 중..."
                                       Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="#d8e6ff"
                                       FontSize="13"/>
                            <TextBlock Text="저장하거나 변경을 취소한 뒤 다른 요약을 선택할 수 있습니다."
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="#f6d365"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="제목"
                                       Foreground="#aaaacc"
                                       FontSize="13"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TitleLengthText}"
                                       Foreground="#aaaacc"
                                       FontSize="12"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding IsEditorEnabled}">
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#16213e"
                                         Foreground="White"
                                         BorderBrush="#e0aaff"
                                         BorderThickness="1"
                                         Padding="8"
                                         FontSize="14"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="현재 상황" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCurrentSituation, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="86"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="주요 사건" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditKeyEvents, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="100"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="관계 변화" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditRelationshipChanges, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="86"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="약속 / 중요한 발언" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditPromisesAndImportantStatements, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="86"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="미해결 사항" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditUnresolvedMatters, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="86"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="지속 상태" Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditPersistentState, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SummaryTextBoxStyle}"
                                         Height="86"
                                         Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">
                            <Button Content="변경 취소"
                                    Width="92"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="#24345f"
                                    Foreground="#e8ddff"
                                    BorderBrush="#5f6fa0"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding DiscardChangesCommand}"/>
                            <Button Content="저장"
                                    Width="82"
                                    Height="34"
                                    Background="#e0aaff"
                                    Foreground="#1a1a2e"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="닫기"
                Width="82"
                Height="34"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Background="#2a2a4a"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
