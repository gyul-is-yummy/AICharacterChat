<Window x:Class="AICharacterChat.WorldSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세계관 설정" Height="540" Width="430"
        Background="#1a1a2e"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="세계관 설정"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#aaddff"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Text="세계관 이름"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Grid.Row="2"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#aaddff" BorderThickness="1"
                     Padding="8" FontSize="14" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="3" Text="장르 (예: 로맨스 판타지, 무협, 현대)"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="GenreBox" Grid.Row="4"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#aaddff" BorderThickness="1"
                     Padding="8" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="5" Text="시대적 배경 (예: 중세, 현대, 조선시대)"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="EraBox" Grid.Row="6"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#aaddff" BorderThickness="1"
                     Padding="8" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="7" Text="세계관 설명"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="8"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#aaddff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <TextBlock Grid.Row="9" Text="세계관 규칙 (마법 체계, 사회 규범 등)"
                       Foreground="#aaaacc" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="RulesBox" Grid.Row="10"
                     Background="#16213e" Foreground="White"
                     BorderBrush="#aaddff" BorderThickness="1"
                     Padding="8" FontSize="13" Height="80"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,24"/>

            <!-- 버튼 -->
            <StackPanel Grid.Row="11" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                <Button x:Name="CancelButton" Content="취소"
                        Width="90" Height="36" Margin="0,0,10,0"
                        Background="#2a2a4a" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="저장"
                        Width="90" Height="36"
                        Background="#2255aa" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>