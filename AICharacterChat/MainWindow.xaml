<Window x:Class="AICharacterChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domainEnums="clr-namespace:AICharacterChat.Domain.Enums"
        Title="로맨스 판타지 채팅" Height="700" Width="720"
        Background="#1a1a2e"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9680c0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="WorldItemTemplate">
            <Border Background="#0f1938" CornerRadius="6" Margin="0,0,0,3" Padding="5,4,3,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{Binding Name}"
                            Command="{Binding DataContext.SelectWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Foreground="#aaddff"
                            BorderThickness="0"
                            FontSize="12"
                            HorizontalContentAlignment="Left"
                            Padding="2,0,0,0"
                            Cursor="Hand"/>
                    <Button Grid.Column="1"
                            Content="⚙"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="세계관 설정 편집"
                            Tag="{Binding}"
                            Click="WorldEdit_Click"/>
                    <Button Grid.Column="2"
                            Content="🗑"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="세계관 삭제"
                            Tag="{Binding}"
                            Click="WorldDelete_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CharacterItemTemplate">
            <Border Background="#1a123a" CornerRadius="6" Margin="0,0,0,3" Padding="5,4,3,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{Binding Name}"
                            Command="{Binding DataContext.SelectCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            Foreground="#f0dcff"
                            BorderThickness="0"
                            FontSize="12"
                            HorizontalContentAlignment="Left"
                            Padding="2,0,0,0"
                            Cursor="Hand"/>
                    <Button Grid.Column="1"
                            Content="⚙"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="캐릭터 설정 편집"
                            Tag="{Binding}"
                            Click="CharacterSettings_Click"/>
                    <Button Grid.Column="2"
                            Content="📖"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="로어북"
                            Tag="{Binding}"
                            Click="CharacterLoreBook_Click"/>
                    <Button Grid.Column="3"
                            Content="↺"
                            Style="{StaticResource IconButtonStyle}"
                            FontSize="13"
                            ToolTip="대화 기록 초기화"
                            Tag="{Binding}"
                            Click="CharacterClearHistory_Click"/>
                    <Button Grid.Column="4"
                            Content="🗑"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="캐릭터 삭제"
                            Tag="{Binding}"
                            Click="CharacterDelete_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate">
            <Border x:Name="Bubble"
                    Background="#16213e"
                    CornerRadius="12"
                    Padding="12,8"
                    Margin="5,4,60,4"
                    HorizontalAlignment="Left"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectSummaryMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <TextBlock Text="{Binding Content}"
                           Foreground="White"
                           FontSize="14"
                           TextWrapping="Wrap"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static domainEnums:ChatRole.User}">
                    <Setter TargetName="Bubble" Property="Background" Value="#7b2ff7"/>
                    <Setter TargetName="Bubble" Property="Margin" Value="60,4,5,4"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInSummarySelectionRange}" Value="True">
                    <Setter TargetName="Bubble" Property="Background" Value="#22375f"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#80c7ff"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSummarySelectionStart}" Value="True">
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#f6d365"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSummarySelectionEnd}" Value="True">
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#f6d365"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#12122a">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="세계관"
                       FontSize="12" FontWeight="Bold"
                       Foreground="#7799cc"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Worlds}"
                              ItemTemplate="{StaticResource WorldItemTemplate}"
                              Margin="6,4,6,0"/>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="＋ 세계관"
                    Margin="8,4"
                    Background="#1a3060" Foreground="#aaddff"
                    BorderThickness="0" FontSize="12"
                    Cursor="Hand"
                    Click="AddWorldButton_Click"/>

            <Rectangle Grid.Row="3" Fill="#2a2a4a"/>

            <TextBlock Grid.Row="4"
                       Text="캐릭터"
                       FontSize="12" FontWeight="Bold"
                       Foreground="#9966cc"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Characters}"
                              ItemTemplate="{StaticResource CharacterItemTemplate}"
                              Margin="6,4,6,0"/>
            </ScrollViewer>

            <Button Grid.Row="6"
                    Content="＋ 캐릭터"
                    Margin="8,4,8,8"
                    Background="#7b2ff7" Foreground="White"
                    BorderThickness="0" FontSize="12"
                    Cursor="Hand"
                    Click="AddCharacterButton_Click"/>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="{Binding SelectedCharacterName}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#e0aaff"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="0,0,4,0">
                    <TextBlock Text="모델:"
                               Foreground="#9966cc"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <ComboBox Width="190"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="Label"
                              FontSize="11"
                              SelectionChanged="ModelComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="5,0,5,4">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding CanShowBeginSummarySelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="요약 만들기"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Background="#24345f"
                            Foreground="#e8ddff"
                            BorderBrush="#5f6fa0"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            Command="{Binding BeginSummarySelectionCommand}"/>
                    <Button Content="요약 관리"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            Background="#2a213d"
                            Foreground="#e8ddff"
                            BorderBrush="#6f4b6f"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            Command="{Binding OpenSummaryManagementCommand}"/>
                </StackPanel>

                <Border Visibility="{Binding IsSummarySelectionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#101832"
                        BorderBrush="#38466f"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0">
                            <Button Content="다음"
                                    Padding="8,3"
                                    Margin="0,0,5,0"
                                    Background="#2c4b7a"
                                    Foreground="#e8f2ff"
                                    BorderBrush="#80c7ff"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Command="{Binding OpenSummaryPreviewCommand}"/>
                            <Button Content="선택 다시 하기"
                                    Padding="8,3"
                                    Margin="0,0,5,0"
                                    Background="#24345f"
                                    Foreground="#e8ddff"
                                    BorderBrush="#5f6fa0"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Command="{Binding ResetSummarySelectionCommand}"/>
                            <Button Content="취소"
                                    Padding="8,3"
                                    Background="#2a213d"
                                    Foreground="#ffdddd"
                                    BorderBrush="#6f4b6f"
                                    BorderThickness="1"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Command="{Binding CancelSummarySelectionCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SummarySelectionStatusText}"
                                       Foreground="#d8e6ff"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SummarySelectionError}"
                                       Visibility="{Binding HasSummarySelectionError, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="#ff9999"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Visibility="{Binding HasUnsummarizedOldMessageWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#18233d"
                    BorderBrush="#536686"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,7"
                    Margin="5,0,5,4">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="요약 만들기"
                            Padding="9,3"
                            Margin="10,0,0,0"
                            Background="#24345f"
                            Foreground="#e8ddff"
                            BorderBrush="#5f6fa0"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            Command="{Binding BeginSummarySelectionCommand}"/>
                    <TextBlock Text="{Binding UnsummarizedOldMessageWarningText}"
                               Foreground="#d8e6ff"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="ChatScrollViewer"
                          Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,5">
                <ItemsControl ItemsSource="{Binding MessageItems}"
                              ItemTemplate="{StaticResource MessageTemplate}"
                              Margin="5"/>
            </ScrollViewer>

            <TextBlock Grid.Row="4"
                       Text="{Binding ErrorMessage}"
                       Foreground="#ff9999"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="5,0,5,6"/>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#16213e" Foreground="White"
                         BorderBrush="#e0aaff" BorderThickness="1"
                         Padding="10" FontSize="14"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1"
                        Content="전송"
                        Margin="5,0,0,0"
                        Background="#7b2ff7" Foreground="White"
                        BorderThickness="0" FontSize="14"
                        Cursor="Hand"
                        Command="{Binding SendMessageCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
